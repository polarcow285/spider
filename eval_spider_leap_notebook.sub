#!/bin/bash
#SBATCH --job-name=spider            # Name of job
#SBATCH --partition=gpu              # Partition to submit to
#SBATCH --nodes=1                    # Number of nodes
#SBATCH --exclude=dgx2-compute-01,jjs533-compute-03,elor-compute-02,taylor-compute-01,snavely-compute-04,snavely-compute-05,snavely-compute-06,snavely-compute-07,snavely-compute-09,snavely-compute-10,snavely-compute-11,snavely-compute-12,bhattacharjee-compute-02,seo-compute-02
#SBATCH --cpus-per-task=16           # Number of CPU cores per task
#SBATCH --ntasks=1                   # Number of tasks
#SBATCH --gres=gpu:1                 # Number of GPUs
#SBATCH --mem=32G                    # Memory allocation
#SBATCH --time=48:00:00              # Time limit
#SBATCH --output=slurm_out/slurm-%j.out        # Standard output log file
echo $HOSTNAME
nvidia-smi
# Changes vs. the leap scissors/screwdriver baseline:
#   CHANGED ctrl_dt / knot_dt 0.66666666 -> 0.33333333, horizon 3.3333333 -> 1.3333333:
#     the whole notebook demo is only 40 frames (1.33 s), and the hinge opens 0 -> 2.1 rad in
#     ~0.9 s (peak ~3.9 rad/s). At 0.67 s control the planner only replans twice; at 0.33 s it
#     replans 4 times. The horizon still covers the full clip, and there are still 5 knots per
#     horizon, so the sampling dimension is unchanged.
#   object_joint_rew_scale=1.0 (new param, same as the default; set explicitly so it shows
#     up in the run command): the notebook base is static and success is hinge > pi/2, so the
#     hinge is the whole task. At 1.0, a 0.3 rad hinge error costs 0.3, which outweighs a
#     5 cm base error (0.05) or 0.3 rad of base rotation (0.09). rot_rew_scale stays at the
#     baseline 0.3.
#   CHANGED num_samples 2048 -> 4096: the clip is 1.33 s, so doubling samples is cheap.
python examples/eval_mjwp.py --seed 4 --csv-path mjwp_eval_results.csv \
  robot_type=leap embodiment_type=right task=notebook \
  dataset_name=arctic data_id=0 --mink \
  sim_dt=0.00208333333 \
  ctrl_dt=0.33333333 \
  ref_dt=0.033333333 \
  render_dt=0.033333333 \
  horizon=1.3333333 \
  knot_dt=0.33333333 \
  num_samples=4096 \
  first_ctrl_noise_scale=0.2 \
  last_ctrl_noise_scale=0.5 \
  base_pos_rew_scale=0.1 \
  base_rot_rew_scale=0.03 \
  joint_rew_scale=0.003 \
  pos_rew_scale=1.0 \
  rot_rew_scale=0.3 \
  object_joint_rew_scale=1.0 \
  vel_rew_scale=0.0 \
  max_num_iterations=32
