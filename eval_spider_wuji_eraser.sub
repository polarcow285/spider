#!/bin/bash
#SBATCH --job-name=spider            # Name of job
#SBATCH --partition=gpu              # Partition to submit to
#SBATCH --nodes=1                    # Number of nodes
#SBATCH --exclude=dgx2-compute-01,jjs533-compute-03,elor-compute-02,taylor-compute-01,snavely-compute-04,snavely-compute-05,snavely-compute-06,snavely-compute-07,snavely-compute-09,snavely-compute-10,snavely-compute-11,snavely-compute-12,bhattacharjee-compute-02,seo-compute-02
#SBATCH --cpus-per-task=16           # Number of CPU cores per task
#SBATCH --ntasks=1                   # Number of tasks
#SBATCH --gres=gpu:1                 # Number of GPUs
#SBATCH --mem=32G                    # Memory allocation
#SBATCH --time=48:00:00              # Time limit
#SBATCH --output=slurm_out/slurm-%j.out        # Standard output log file
echo $HOSTNAME
nvidia-smi
# Changes vs. the wuji scissors baseline:
#   CHANGED pos_rew_scale 1.5 -> 2.0: the eraser barely rotates (17 deg over the demo) and
#     only lifts ~2 cm; the task is sliding it ~24 cm along the table, so object position is
#     the signal that matters. rot_rew_scale stays at 0.3 so yaw doesn't drift.
#   CHANGED launcher eval_mjwp.py -> run_mjwp.py: there is no eraser metric in
#     eval_mjwp.py or dexrl's eval_recorded_traj.py, so eval_mjwp.py would raise before running.
#     This produces the MJWP rollout only (no CSV row).
python examples/run_mjwp.py seed=4 \
  robot_type=wuji embodiment_type=right task=eraser \
  dataset_name=custom data_id=0 --mink \
  sim_dt=0.00208333333 \
  ctrl_dt=0.66666666 \
  ref_dt=0.033333333 \
  render_dt=0.033333333 \
  horizon=3.3333333 \
  knot_dt=0.66666666 \
  num_samples=4096 \
  first_ctrl_noise_scale=0.2 \
  last_ctrl_noise_scale=0.5 \
  base_pos_rew_scale=0.1 \
  base_rot_rew_scale=0.03 \
  joint_rew_scale=0.003 \
  pos_rew_scale=2.0 \
  rot_rew_scale=0.3 \
  vel_rew_scale=0.0 \
  max_num_iterations=32
