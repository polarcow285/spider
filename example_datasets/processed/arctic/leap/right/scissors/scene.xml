<mujoco model="leap_right_hand">
  <compiler angle="radian" meshdir="../../../assets" />
  <!-- Match leap-screwdriver sim2sim MJCF for integrator step vs env.yaml control_dt substeps -->
  <option timestep="0.0008333333333333333" integrator="implicitfast" cone="elliptic" impratio="100"/>

  <asset>
    <material name="black" rgba="0.2 0.2 0.2 1" />
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- hand meshes -->
    <mesh name="palm" file="robots/leap/assets/palm_right.obj"/>
    <mesh name="base" file="robots/leap/assets//base.obj"/>
    <mesh name="proximal" file="robots/leap/assets/proximal.obj"/>
    <mesh name="medial" file="robots/leap/assets/medial.obj"/>
    <mesh name="distal" file="robots/leap/assets/distal.obj"/>
    <mesh name="tip" file="robots/leap/assets/tip.obj"/>
    <mesh name="thumb_base" file="robots/leap/assets/thumb_base.obj"/>
    <mesh name="thumb_proximal" file="robots/leap/assets/thumb_proximal.obj"/>
    <mesh name="thumb_distal" file="robots/leap/assets//thumb_distal.obj"/>
    <mesh name="thumb_tip" file="robots/leap/assets/thumb_tip.obj"/>


    <!-- Meshes -->
    <mesh name="top_visual" file="objects/scissors/top.obj" scale="0.002 0.002 0.002"/>
    <mesh name="top_collision_0" file="objects/scissors/top_simplified/top_simplified_part_000.obj" scale="2 2 2"/>
